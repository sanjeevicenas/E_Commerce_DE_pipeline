{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dp203deadf"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"DP203AzureSqlDatabase_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'DP203AzureSqlDatabase'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dp203adlsstg.dfs.core.windows.net/"
		},
		"DP203AzureSqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dp203dedbserver.database.windows.net"
		},
		"DP203AzureSqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dp203dedb"
		},
		"DP203AzureSqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dp203"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dp203deadf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"DP203AzureSqlDatabase_password": {
						"value": "[parameters('DP203AzureSqlDatabase_password')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"DP203AzureSqlDatabase_properties_typeProperties_server": {
						"value": "[parameters('DP203AzureSqlDatabase_properties_typeProperties_server')]"
					},
					"DP203AzureSqlDatabase_properties_typeProperties_database": {
						"value": "[parameters('DP203AzureSqlDatabase_properties_typeProperties_database')]"
					},
					"DP203AzureSqlDatabase_properties_typeProperties_userName": {
						"value": "[parameters('DP203AzureSqlDatabase_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}